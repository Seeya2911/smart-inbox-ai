# OpenAI configuration
# Only the API key is required for direct OpenAI evaluation.
OPENAI_API_KEY=replace_me

# Optional overrides. The defaults are the standard OpenAI API endpoint and gpt-5.6.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6

# Legacy LLM_* variables remain supported for other OpenAI-compatible providers.
